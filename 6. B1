#include <stdio.h>

int calls = 0;

int factorial(int n)
{
    calls++;

    if (n <= 1)
        return 1;

    return n * factorial(n - 1);
}

int main(void)
{
    int n;

    printf("Enter n (0 to 12): ");

    if (scanf("%d", &n) != 1 || n < 0 || n > 12)
    {
        printf("Invalid input\n");
        return 1;
    }

    printf("Factorial = %d\n", factorial(n));
    printf("Recursive calls = %d\n", calls);

    return 0;
}
