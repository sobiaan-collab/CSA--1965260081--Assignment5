#include <stdio.h>

long long fib_slow(int n)
{
    if (n < 2)
        return n;

    return fib_slow(n - 1) + fib_slow(n - 2);
}

long long fib_fast(int n, long long memo[])
{
    if (n < 2)
        return n;

    if (memo[n] != -1)
        return memo[n];

    memo[n] = fib_fast(n - 1, memo) +
              fib_fast(n - 2, memo);

    return memo[n];
}

long long fib_iter(int n)
{
    long long a = 0, b = 1;

    for (int i = 0; i < n; i++)
    {
        long long t = a + b;
        a = b;
        b = t;
    }

    return a;
}

int main(void)
{
    int n;
    long long memo[51];

    if (scanf("%d", &n) != 1 || n < 0 || n > 50)
    {
        printf("Enter an integer from 0 to 50\n");
        return 1;
    }

    for (int i = 0; i <= 50; i++)
        memo[i] = -1;

    if (n <= 40)
        printf("Naive = %lld\n", fib_slow(n));
    else
        printf("Naive skipped for large n\n");

    printf("Memoized = %lld\n", fib_fast(n, memo));
    printf("Iterative = %lld\n", fib_iter(n));

    return 0;
}
